{
  "name": "opsark-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "node server/server.mjs --dev",
    "dev:vite": "vite --host 127.0.0.1 --port 5176",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:server": "node --test server/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "start": "node server/server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@fontsource-variable/manrope": "^5.2.6",
    "@phosphor-icons/vue": "^2.2.1",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.7.3",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "vue-tsc": "2.2.12"
  }
}
