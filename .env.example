# Optional. Defaults to the same-origin /api/contact endpoint served by npm start.
VITE_CONTACT_ENDPOINT=/api/contact

# Runtime download addresses: full HTTP(S) URLs or same-origin /downloads/... paths.
# Set these after uploading the real installation packages, then restart npm start.
WINDOWS_DOWNLOAD_URL=
MACOS_DOWNLOAD_URL=

# Optional browser override. The default API uses the runtime URLs above.
VITE_DOWNLOAD_MANIFEST_URL=/api/releases

# Space- or comma-separated HTTPS origins allowed by connect-src when a browser API is cross-origin.
CSP_CONNECT_SRC=

# Production server settings. Keep webhook credentials server-side.
PORT=5176
HOST=127.0.0.1
# Use an absolute path on a persistent volume in production, outside the website directory.
CONTACT_STORAGE_PATH=runtime/leads.jsonl
CONTACT_WEBHOOK_URL=

# Set to the number of trusted reverse proxies only when direct access is blocked.
TRUST_PROXY_HOPS=0
